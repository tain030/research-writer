{
  "name": "research-writer",
  "version": "0.7.2",
  "description": "A quiet, local-first research writing editor.",
  "author": {
    "name": "tain",
    "email": "tain030@users.noreply.github.com"
  },
  "homepage": "https://github.com/tain030/research-writer",
  "repository": {
    "type": "git",
    "url": "https://github.com/tain030/research-writer.git"
  },
  "desktopName": "research-writer.desktop",
  "main": "electron/main.mjs",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/electron-dev.mjs",
    "dev:web": "vite dev",
    "build": "vite build",
    "build:backend": "cargo build --manifest-path src-tauri/Cargo.toml --locked --release --bin research-writer-backend",
    "dist": "pnpm build && pnpm build:backend && electron-builder",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "verify": "sh scripts/verify-local.sh",
    "server:check": "sh _deploy/deploy-to-server.sh --dry-run",
    "server:sync": "sh _deploy/deploy-to-server.sh",
    "release:check": "node scripts/release-version.mjs check",
    "release:version": "node scripts/release-version.mjs set"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-heading": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "diff": "9.0.0",
    "katex": "0.18.1",
    "marked": "17.0.6",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.0",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.tain.researchwriter",
    "productName": "Research Writer",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src-tauri/target/release",
        "to": "backend",
        "filter": [
          "research-writer-backend",
          "research-writer-backend.exe"
        ]
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "artifactName": "research-writer_${version}_${arch}.${ext}",
      "category": "Office",
      "executableName": "research-writer",
      "syncDesktopName": true,
      "icon": "src-tauri/icons/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "research-writer_${version}_${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "src-tauri/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "artifactName": "research-writer_${version}_${arch}_setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "research-writer_${version}_${arch}_portable.${ext}"
    }
  }
}
